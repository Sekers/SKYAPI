.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Ignore Everything Inside the Config Folder Except the Placeholder File.
# This folder holds live configuration and can also hold a private key certificate (.pfx), so ignore
# everything rather than just the file types we currently expect to find in there.
/Config/*
!/Config/@Place Config Files Here

# Never Commit Private Key Material
*.pfx
*.p12
*.pem
*.key

# Ignore the Logging Folder
/Logging